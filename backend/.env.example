# Copy to .env and fill in the key(s) for whichever provider you use.

LLM_PROVIDER=openai
# "openai" also covers OpenRouter/DeepSeek/Groq/any OpenAI-compatible API. Use "anthropic" for Claude directly.

OPENAI_API_KEY=your_openai_or_openrouter_key_here
OPENAI_BASE_URL=
# e.g. https://openrouter.ai/api/v1 for OpenRouter, blank for real OpenAI
OPENAI_MODEL=gpt-4o-mini
# e.g. deepseek/deepseek-chat if using OpenRouter

ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: custom path for the Application Tracker spreadsheet.
# APPLICATIONS_XLSX_PATH=C:\Users\you\Documents\my_applications.xlsx
