# Node.js
extension/node_modules/
extension/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
backend/venv/
backend/.venv/
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
pip-log.txt
pip-delete-this-directory.txt

# Environment & Secrets
.env
.env.*
*.env
!*.env.example
*.pem
*.key
*.cert
credentials.json

# Candidate Profile & Personal Sensitive Data
# context.example.md is distributed as a downloadable Release asset, not a repo
# file -- see README Configuration section. The backend/me/ folder itself is
# kept (via .gitkeep) so a fresh clone has somewhere to drop context.md, but
# nothing placed inside it is ever tracked.
backend/me/*
!backend/me/.gitkeep
context.md
**/context.md
backend/scratch/
*.pdf
*.docx
*.doc

# Application Tracker (personal job-search data). Folder itself is kept (via
# .gitkeep) so a fresh clone has somewhere to drop a spreadsheet; contents aren't.
backend/data/*
!backend/data/.gitkeep

# Internal dev notes -- not part of the public fork
CLAUDE.md
CHANGELOG.md

# Editor / System
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
