# Which LLM provider handles form-field matching: "openai" or "anthropic".
# Defaults to "openai" if unset. Switching providers only requires changing
# this value and setting the matching API key below -- no code changes.
# LLM_PROVIDER=openai

# OpenAI API Key for autofill extraction & matching (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key for autofill extraction & matching (used when LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the default model for either provider.
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-4-5

# --- Using OpenRouter, DeepSeek, Groq, Together, or any other OpenAI-compatible
# provider instead of OpenAI itself ---
# Keep LLM_PROVIDER=openai (or set it to "openai_compatible", same thing), then
# point it at that provider's own endpoint + key + model string. Examples:
#
# OpenRouter (gives you one key for DeepSeek, Qwen, Llama, and many more):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-your-openrouter-key-here
# OPENAI_MODEL=deepseek/deepseek-chat
#
# DeepSeek direct:
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=your-deepseek-key-here
# OPENAI_MODEL=deepseek-chat
#
# Not every model behind a third-party endpoint honors strict structured-output
# schemas as reliably as OpenAI's own models -- if a cheaper model starts
# producing malformed fill plans, that's a model capability limit, not a bug
# here. Try a different model on the same provider before assuming otherwise.

# Optional: path to your Application Tracker spreadsheet. If unset, defaults to
# backend/data/Application_Tracker.xlsx. Point this anywhere on disk to use
# your own copy without keeping an .xlsx inside the repo.
# APPLICATIONS_XLSX_PATH=C:\Users\you\Documents\my_applications.xlsx
