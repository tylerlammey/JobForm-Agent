{
  "manifest_version": 3,
  "name": "Job Autofiller Scaffold",
  "version": "1.3.0",
  "description": "Minimal working scaffold for Chrome Extension ↔ FastAPI communication",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "*://*.instagram.com/*",
    "*://*.cdninstagram.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_instagram",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
